{
  "name": "rasoios-restaurant-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:static": "vitest run --project static",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "prisma:gen": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:local": "tsx scripts/db-local.ts",
    "platform:grant-super-admin": "tsx scripts/grant-super-admin.ts",
    "agent:build": "node print-agent/build.mjs",
    "agent:dev": "tsx --tsconfig tsconfig.json print-agent/src/main.ts",
    "printer:simulator": "tsx tools/printer-simulator/cli.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "2.33.6",
    "@clerk/nextjs": "^6.12.0",
    "@prisma/client": "^6.3.1",
