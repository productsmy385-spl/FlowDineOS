# RASOIOS local print agent (S1-P17-T009, Q-010). Installed by install.sh.
# Exit status 2 means "not paired / token revoked": systemd must not restart-loop on it.
[Unit]
Description=FlowDineOS print agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rasoios-agent
Group=rasoios-agent
# usblp devices (/dev/usb/lp*) belong to the lp group.
SupplementaryGroups=lp
Environment=RASOIOS_AGENT_HOME=/var/lib/rasoios-print-agent
StateDirectory=rasoios-print-agent
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/env node /opt/rasoios-print-agent/rasoios-print-agent.cjs run
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2

# Hardening: the agent only needs outbound TCP and its state directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
# No DeviceAllow=: that would close the device policy. USB printer access is governed by /dev/usb/lp* ownership (lp).

[Install]
WantedBy=multi-user.target
