// ───────────────────────── E29 PRINTER_DISCOVERY (RASOIOS-ADR-015) ─────────────────────────

/// One LAN scan an admin asked an agent to run. `results` holds only what the agent observed (private IPv4, port,
/// advertised names); nothing becomes a PRINTER until a person adds it. Rows are tenant-owned like every agent row.
model PrinterDiscovery {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  printAgentId      String                 @map("print_agent_id") @db.Uuid
  status            PrinterDiscoveryStatus @default(REQUESTED)
  results           Json?                  @db.JsonB
  errorCode         String?                @map("error_code") @db.VarChar(40)
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt         DateTime?              @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printAgent  PrintAgent @relation(fields: [tenantId, printAgentId], references: [tenantId, id], onDelete: Restrict)
  requestedBy User       @relation("PrinterDiscoveryRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, printAgentId, status])
  @@map("printer_discoveries")
}

// ───────────────────────── E23 PRINT_JOB ─────────────────────────

model PrintJob {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  printerId         String         @map("printer_id") @db.Uuid
  printAgentId      String?        @map("print_agent_id") @db.Uuid
  jobType           PrintJobType   @map("job_type")
  orderId           String?        @map("order_id") @db.Uuid
  kotTicketId       String?        @map("kot_ticket_id") @db.Uuid
  dedupeKey         String         @map("dedupe_key") @db.VarChar(120)
  isReprint         Boolean        @default(false) @map("is_reprint")
  payload           Json           @db.JsonB
  status            PrintJobStatus @default(PENDING)
  attemptCount      Int            @default(0) @map("attempt_count") @db.SmallInt
  maxAttempts       Int            @default(3) @map("max_attempts") @db.SmallInt
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  claimToken        String?        @map("claim_token") @db.Uuid
  claimedAt         DateTime?      @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt    DateTime?      @map("lease_expires_at") @db.Timestamptz(6)
  printedAt         DateTime?      @map("printed_at") @db.Timestamptz(6)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(6)
  lastErrorCode     String?        @map("last_error_code") @db.VarChar(40)
  lastErrorMessage  String?        @map("last_error_message") @db.VarChar(500)
  requestedByUserId String?        @map("requested_by_user_id") @db.Uuid
  // Removed from the history view (RASOIOS-ADR-022): finished jobs only; the row and its audit stay.
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  archivedByUserId  String?        @map("archived_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  archivedBy  User?       @relation("PrintJobArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  printer     Printer     @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: Restrict)
  printAgent  PrintAgent? @relation(fields: [tenantId, printAgentId], references: [tenantId, id], onDelete: Restrict)
  order       Order?      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  kotTicket   KotTicket?  @relation(fields: [tenantId, kotTicketId], references: [tenantId, id], onDelete: Restrict)
  requestedBy User?       @relation("PrintJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey])
  @@unique([tenantId, id])
  @@index([tenantId, printerId, status, nextAttemptAt])
  @@index([tenantId, orderId])
  @@index([tenantId, kotTicketId])
  @@index([tenantId, updatedAt])
  @@map("print_jobs")
}

// ───────────────────────── E24 AUDIT_LOG (append-only; trigger in 0001_init) ─────────────────────────

model AuditLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorAgentId String?        @map("actor_agent_id") @db.Uuid
  actorRole    String?        @map("actor_role") @db.VarChar(20)
  action       String         @db.VarChar(80)
  resourceType String         @map("resource_type") @db.VarChar(40)
  resourceId   String?        @map("resource_id") @db.Uuid
  beforeState  Json?          @map("before_state") @db.JsonB
  afterState   Json?          @map("after_state") @db.JsonB
  reason       String?        @db.VarChar(500)
  requestId    String?        @map("request_id") @db.VarChar(64)
  ipAddress    String?        @map("ip_address") @db.Inet
  userAgent    String?        @map("user_agent") @db.VarChar(256)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_logs")
}

// ───────────────────────── E25 SOCIAL_POST (manual sharing; never "published" by the system) ─────────────────────────

model SocialPost {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  channel              SocialChannel
  cardType             SocialCardType   @map("card_type")
  dailyMenuId          String?          @map("daily_menu_id") @db.Uuid
  menuItemId           String?          @map("menu_item_id") @db.Uuid
  caption              String           @db.VarChar(2200)
  shareUrl             String           @map("share_url") @db.VarChar(2048)
  status               SocialPostStatus @default(DRAFT)
  postedUrl            String?          @map("posted_url") @db.VarChar(2048)
  markedPostedAt       DateTime?        @map("marked_posted_at") @db.Timestamptz(6)
  markedPostedByUserId String?          @map("marked_posted_by_user_id") @db.Uuid
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dailyMenu      DailyMenu? @relation(fields: [tenantId, dailyMenuId], references: [tenantId, id], onDelete: Restrict)
  menuItem       MenuItem?  @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict)
  markedPostedBy User?      @relation("SocialPostMarkedBy", fields: [markedPostedByUserId], references: [id], onDelete: Restrict)
  createdBy      User       @relation("SocialPostCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("social_posts")
}

// ───────────────────────── E26 TENANT_COUNTER (ADR-010 §6) ─────────────────────────

model TenantCounter {
  tenantId     String      @map("tenant_id") @db.Uuid
  counterType  CounterType @map("counter_type")
  businessDate DateTime    @map("business_date") @db.Date
  lastValue    Int         @default(0) @map("last_value")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, counterType, businessDate])
  @@map("tenant_counters")
}

// ───────────────────────── E27 RATE_LIMIT_BUCKET (not tenant data; ADR-011) ─────────────────────────

model RateLimitBucket {
  bucketKey   String   @id @map("bucket_key") @db.VarChar(128)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hitCount    Int      @default(0) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ───────────────────────── E28 MEDIA_ASSET (RASOIOS-ADR-017; supersedes Q-009 A) ─────────────────────────

/// What an uploaded image is for; decides the ImageKit folder and the permission needed (lib/media/purposes.ts).
enum MediaPurpose {
  LOGO
  COVER
  HERO
  FAVICON
  WEBSITE_SECTION
  MENU_ITEM

  @@map("media_purpose")
}

/// A row is written only after ImageKit has stored the file (no PENDING state: uploads are proxied, ADR-017 §2).
enum MediaStatus {
  READY
  DELETED

  @@map("media_status")
}

/// One image stored in ImageKit. Only the reference and metadata live here — never the bytes (ADR-017 §1).
model MediaAsset {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  purpose          MediaPurpose
  status           MediaStatus  @default(READY)
  /// ImageKit fileId — the only handle used to delete the file.
  providerFileId   String       @unique @map("provider_file_id") @db.VarChar(64)
  /// /rasoios/restaurants/{tenantId}/{folder}/{uuid}.{ext}, built on the server.
  storagePath      String       @unique @map("storage_path") @db.VarChar(255)
  /// Untransformed CDN URL, exactly as stored in logo_url, image_url and the other image columns.
  url              String       @unique @db.VarChar(2048)
  contentType      String       @map("content_type") @db.VarChar(40)
  byteSize         Int          @map("byte_size")
  width            Int
  height           Int
  sha256           String       @db.Char(64)
  originalFilename String?      @map("original_filename") @db.VarChar(120)
  uploadedByUserId String       @map("uploaded_by_user_id") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation("MediaAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, purpose, status])
  @@map("media_assets")
}

// ───────────────────────── E26 STAFF DAILY LOGIN (RASOIOS-ADR-019) ─────────────────────────

enum StaffCredentialStatus {
  ACTIVE
  REVOKED

  @@map("staff_credential_status")
}

enum StaffSessionStatus {
  ACTIVE
  ENDED

  @@map("staff_session_status")
}

/** Why a staff session stopped. Kept distinct from the status so attendance can tell a shift from a revocation. */
enum StaffSessionEndReason {
  SIGNED_OUT
  ADMIN_FORCE_LOGOUT
  CREDENTIAL_REVOKED
  EXPIRED

  @@map("staff_session_end_reason")
}

/**
 * One workday's password for one staff membership (ADR-019). Only the scrypt hash is stored: the plaintext is shown
 * to the administrator once, at generation, and is not recoverable afterwards.
 *
 * At most one ACTIVE credential per membership (partial unique index in the migration), so regenerating invalidates
 * the previous password by construction rather than by remembering to.
 */
model StaffCredential {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  membershipId      String                @map("membership_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  passwordHash      String                @map("password_hash") @db.VarChar(255)
  /** The restaurant's own business date this password is for, in its timezone — never a UTC calendar day. */
  businessDate      DateTime              @map("business_date") @db.Date
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(6)
  status            StaffCredentialStatus @default(ACTIVE)
  failedAttempts    Int                   @default(0) @map("failed_attempts")
  generatedByUserId String                @map("generated_by_user_id") @db.Uuid
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership  UserTenant      @relation("StaffCredentialMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  user        User            @relation("StaffCredentialUser", fields: [userId], references: [id], onDelete: Restrict)
  generatedBy User            @relation("StaffCredentialGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  sessions    StaffSession[]

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, status])
  @@index([tenantId, businessDate])
  @@map("staff_credentials")
}

/**
 * One staff working session: the attendance record and the server-side session at once (ADR-019 §4).
 *
 * The cookie carries an opaque token; only its SHA-256 is stored, so the database never holds anything that could
 * be replayed. Force logout ends the row, and because every request re-reads it, access stops on the next request
 * rather than when a browser happens to drop a cookie.
 */
model StaffSession {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  credentialId String                 @map("credential_id") @db.Uuid
  role         TenantRole
  tokenHash    String                 @unique @map("token_hash") @db.Char(64)
  status       StaffSessionStatus     @default(ACTIVE)
  endReason    StaffSessionEndReason? @map("end_reason")
  /** The restaurant's business date the shift belongs to, so attendance groups by workday not by UTC midnight. */
  businessDate DateTime               @map("business_date") @db.Date
  loginAt      DateTime               @default(now()) @map("login_at") @db.Timestamptz(6)
  lastSeenAt   DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  endedAt      DateTime?              @map("ended_at") @db.Timestamptz(6)
  expiresAt    DateTime               @map("expires_at") @db.Timestamptz(6)
  ipAddress    String?                @map("ip_address") @db.VarChar(45)
  userAgent    String?                @map("user_agent") @db.VarChar(255)
  endedByUserId String?               @map("ended_by_user_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership UserTenant      @relation("StaffSessionMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  user       User            @relation("StaffSessionUser", fields: [userId], references: [id], onDelete: Restrict)
  credential StaffCredential @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Restrict)
  endedBy    User?           @relation("StaffSessionEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, membershipId])
  @@index([tenantId, businessDate])
  @@map("staff_sessions")
}
