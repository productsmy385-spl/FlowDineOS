// RASOIOS schema v2 — implements knowledge/implementation/slice-01/data-model.md (E01–E27); audited field by field 2026-09-22.
// E28 MEDIA_ASSET is omitted until Q-009 is decided (S1-P07-T008).
//
// Conventions (data-model §1): UUID ids generated by the database; money NUMERIC(12,2); rates NUMERIC(5,2);
// timestamps TIMESTAMPTZ in UTC; business dates DATE in the restaurant timezone; every tenant-owned table has
// UNIQUE (tenant_id, id) and children reference parents with composite (tenant_id, parent_id) foreign keys (ADR-008).
// Constraints Prisma cannot express (partial unique indexes on lower(name), UNIQUE NULLS NOT DISTINCT, CHECKs,
// the audit immutability trigger) live in prisma/migrations/0001_init (S1-P02-T003).
// Commercial model (ADR-002): no plan, tier, subscription, billing or feature-flag fields anywhere (TC-DB-003).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ───────────────────────── Enums (data-model §1.6) ─────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum PlatformRole {
  NONE
  SUPER_ADMIN

  @@map("platform_role")
}

/// Console colour scheme chosen by a person (RASOIOS-ADR-016). Never a restaurant website theme.
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM

  @@map("theme_preference")
}

enum TenantRole {
  TENANT_ADMIN
  MANAGER
  CASHIER
  KITCHEN
  WAITER

  @@map("tenant_role")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum DietaryType {
  VEG
  NON_VEG
  EGG

  @@map("dietary_type")
}

enum DailyMenuStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED

  @@map("daily_menu_status")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY

  @@map("order_type")
}

enum OrderChannel {
  STAFF
  PUBLIC_WEB

  @@map("order_channel")
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum OrderPriority {
  NORMAL
  HIGH

  @@map("order_priority")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum KotStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("kot_status")
}

enum TransactionType {
  PAYMENT
  REFUND

  @@map("transaction_type")
}

enum PaymentMethod {
  CASH
  CARD
  UPI

  @@map("payment_method")
}

enum TransactionStatus {
  SUCCESS
  VOIDED

  @@map("transaction_status")
}

enum PrinterPurpose {
  KOT
  RECEIPT
  KOT_AND_RECEIPT

  @@map("printer_purpose")
}

enum PrinterConnection {
  USB
  LAN

  @@map("printer_connection")
}

enum PrinterHealth {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR

  @@map("printer_health")
}

enum PrintAgentStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED

  @@map("print_agent_status")
}

/// A console-requested LAN printer scan (RASOIOS-ADR-015): REQUESTED → RUNNING (agent picked it up) → COMPLETED/FAILED.
enum PrinterDiscoveryStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED

  @@map("printer_discovery_status")
}

enum PrintJobType {
  KOT
  RECEIPT
  TEST

  @@map("print_job_type")
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  PRINTED
  FAILED

  @@map("print_job_status")
}

enum AuditActorType {
  USER
  PRINT_AGENT
  SYSTEM
  PUBLIC
  WEBHOOK

  @@map("audit_actor_type")
}

enum SocialChannel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  OTHER

  @@map("social_channel")
}

enum SocialCardType {
  DAILY_MENU
  MENU_ITEM
  FULL_MENU

  @@map("social_card_type")
}

enum SocialPostStatus {
  DRAFT
  READY
  MARKED_POSTED
  ARCHIVED

  @@map("social_post_status")
}

enum WebsiteThemePreset {
  PLATFORM
  CITRUS
  OCEAN
  BERRY
  CUSTOM

  @@map("website_theme_preset")
}

enum WebsiteSurfaceMode {
  DARK
  LIGHT

  @@map("website_surface_mode")
}

enum WebsiteSectionKey {
  HERO
  ABOUT
  FEATURED_MENU
  CATEGORIES
  POPULAR_ITEMS
  INFO
  HOURS
  GALLERY
  LOCATION
  CONTACT
  CTA

  @@map("website_section_key")
}

enum MenuStyle {
  RING
  GRID

  @@map("menu_style")
}

enum DailyStyle {
  STRIP
  GRID

  @@map("daily_style")
}

enum BackupReminder {
  MANUAL
  MONTHLY
  SIX_MONTHS

  @@map("backup_reminder")
}

enum CounterType {
  ORDER
  KOT

  @@map("counter_type")
}

// ───────────────────────── E01 TENANT ─────────────────────────

model Tenant {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String       @db.VarChar(120)
  slug             String       @unique @db.VarChar(48)
  status           TenantStatus @default(ACTIVE)
  suspendedAt      DateTime?    @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?      @map("suspension_reason") @db.VarChar(500)
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User? @relation("TenantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  restaurant        Restaurant?
  websiteSections WebsiteSection[]
  restaurantHours   RestaurantHours[]
  kitchenSections   KitchenSection[]
  memberships       UserTenant[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  menuItemVariants  MenuItemVariant[]
  menuItemAddons    MenuItemAddon[]
  dailyMenus        DailyMenu[]
  dailyMenuItems    DailyMenuItem[]
  customers         Customer[]
  orders            Order[]
  orderItems        OrderItem[]
  orderItemAddons   OrderItemAddon[]
  kotTickets        KotTicket[]
  kotItems          KotItem[]
  transactions      Transaction[]
  businessDayCloses BusinessDayClose[]
  printers          Printer[]
  printAgents       PrintAgent[]
  printerDiscoveries PrinterDiscovery[]
  printJobs         PrintJob[]
  auditLogs         AuditLog[]
  socialPosts       SocialPost[]
  mediaAssets       MediaAsset[]
  staffCredentials  StaffCredential[]
  staffSessions     StaffSession[]
  counters          TenantCounter[]
  diningTables      DiningTable[]

  @@index([status])
  @@map("tenants")
}

// ───────────────────────── E02 RESTAURANT (1:1 with TENANT, Q-002) ─────────────────────────

model Restaurant {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @unique @map("tenant_id") @db.Uuid
  name             String    @db.VarChar(120)
  description      String?   @db.VarChar(1000)
  logoUrl          String?   @map("logo_url") @db.VarChar(2048)
  coverImageUrl    String?   @map("cover_image_url") @db.VarChar(2048)
  brandAccentHex   String?   @map("brand_accent_hex") @db.Char(7)
  tagline          String?   @db.VarChar(160)
  heroImageUrl     String?   @map("hero_image_url") @db.VarChar(2048)
  faviconUrl       String?   @map("favicon_url") @db.VarChar(2048)
  themePreset      WebsiteThemePreset @default(PLATFORM) @map("theme_preset")
  themeSurfaceMode WebsiteSurfaceMode @default(DARK) @map("theme_surface_mode")
  themePrimaryHex  String?   @map("theme_primary_hex") @db.Char(7)
  themeSecondaryHex String?  @map("theme_secondary_hex") @db.Char(7)
  gradientFromHex  String?   @map("gradient_from_hex") @db.Char(7)
  gradientToHex    String?   @map("gradient_to_hex") @db.Char(7)
  instagramUrl     String?   @map("instagram_url") @db.VarChar(2048)
  facebookUrl      String?   @map("facebook_url") @db.VarChar(2048)
  whatsappE164     String?   @map("whatsapp_e164") @db.VarChar(16)
  mapsUrl          String?   @map("maps_url") @db.VarChar(2048)
  phoneE164        String?   @map("phone_e164") @db.VarChar(16)
  email            String?   @db.VarChar(254)
  addressLine1     String?   @map("address_line1") @db.VarChar(160)
  addressLine2     String?   @map("address_line2") @db.VarChar(160)
  city             String?   @db.VarChar(80)
  region           String?   @db.VarChar(80)
  postalCode       String?   @map("postal_code") @db.VarChar(16)
  countryCode      String    @map("country_code") @db.Char(2)
  timezone         String    @db.VarChar(64)
  currencyCode     String    @map("currency_code") @db.Char(3)
  showPhone        Boolean   @default(true) @map("show_phone")
  showEmail        Boolean   @default(true) @map("show_email")
  showAddress      Boolean   @default(true) @map("show_address")
  websitePublished Boolean   @default(false) @map("website_published")
  seoTitle         String?   @map("seo_title") @db.VarChar(60)
  seoDescription   String?   @map("seo_description") @db.VarChar(160)
  defaultOrderType OrderType @default(DINE_IN) @map("default_order_type")
  autoPrintKot     Boolean   @default(true) @map("auto_print_kot")
  receiptFooter    String?   @map("receipt_footer") @db.VarChar(280)
  gstin            String?   @db.VarChar(15)
  // Brand Kit (RASOIOS-ADR-021): named colours in the tenant's own order, fonts from an allow-list, extra logos, voice.
  brandColors      Json      @default("[]") @map("brand_colors") @db.JsonB
  headingFont      String?   @map("heading_font") @db.VarChar(40)
  bodyFont         String?   @map("body_font") @db.VarChar(40)
  accentFont       String?   @map("accent_font") @db.VarChar(40)
  logoLightUrl     String?   @map("logo_light_url") @db.VarChar(2048)
  logoDarkUrl      String?   @map("logo_dark_url") @db.VarChar(2048)
  brandVoice       String?   @map("brand_voice") @db.VarChar(500)
  // Data backups (RASOIOS-ADR-021): how often the console reminds the admin to download a backup. Nothing is uploaded.
  backupReminder   BackupReminder @default(MANUAL) @map("backup_reminder")
  // Public menu presentation (RASOIOS-ADR-022): the 3D ring *is* the main menu; today's menu has its own strip.
  menuStyle        MenuStyle      @default(RING) @map("menu_style")
  dailyStyle       DailyStyle     @default(STRIP) @map("daily_style")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hours    RestaurantHours[]
  sections WebsiteSection[]

  @@unique([tenantId, id])
  @@map("restaurants")
}

// ───────────────────────── E02a WEBSITE_SECTION (ADR-013 §6) ─────────────────────────

model WebsiteSection {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  key          WebsiteSectionKey
  enabled      Boolean           @default(true)
  sortOrder    Int               @default(0) @map("sort_order") @db.SmallInt
  headline     String?           @db.VarChar(120)
  body         String?           @db.VarChar(1000)
  imageUrl     String?           @map("image_url") @db.VarChar(2048)
  ctaLabel     String?           @map("cta_label") @db.VarChar(40)
  ctaHref      String?           @map("cta_href") @db.VarChar(2048)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  restaurant Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, restaurantId, key])
  @@index([tenantId, restaurantId, sortOrder])
  @@map("website_sections")
}

// ───────────────────────── E30 DINING_TABLE (table QR menus, RASOIOS-ADR-021) ─────────────────────────

/// A table a customer can sit at. Its QR code carries `publicCode` — a random, rotatable code — never the tenant id or
/// the row id; the public route resolves it only together with the restaurant's own slug.
model DiningTable {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  label      String    @db.VarChar(20)
  publicCode String    @unique @map("public_code") @db.VarChar(16)
  isActive   Boolean   @default(true) @map("is_active")
  sortOrder  Int       @default(0) @map("sort_order") @db.SmallInt
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, sortOrder])
  @@map("dining_tables")
}

// ───────────────────────── E03 RESTAURANT_HOURS ─────────────────────────

model RestaurantHours {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  dayOfWeek    Int       @map("day_of_week") @db.SmallInt
  sequence     Int       @default(1) @db.SmallInt
  isClosed     Boolean   @default(false) @map("is_closed")
  opensAt      DateTime? @map("opens_at") @db.Time(0)
  closesAt     DateTime? @map("closes_at") @db.Time(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  restaurant Restaurant @relation(fields: [tenantId, restaurantId], references: [tenantId, id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, sequence])
  @@unique([tenantId, id])
  @@map("restaurant_hours")
}

// ───────────────────────── E04 KITCHEN_SECTION ─────────────────────────

model KitchenSection {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(60)
  code       String    @db.VarChar(24)
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItems  MenuItem[]
  orderItems OrderItem[]
  kotTickets KotTicket[]
  printers   Printer[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, sortOrder])
  @@map("kitchen_sections")
}

// ───────────────────────── E05 USER (global identity) ─────────────────────────

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId  String?      @unique @map("clerk_user_id") @db.VarChar(64)
  email        String       @unique @db.VarChar(254)
  fullName     String?      @map("full_name") @db.VarChar(120)
  platformRole PlatformRole @default(NONE) @map("platform_role")
  status       UserStatus   @default(ACTIVE)
  lastSignInAt DateTime?    @map("last_sign_in_at") @db.Timestamptz(6)
  /// Console light/dark choice (ADR-016); DARK keeps the ADR-013 default.
  themePreference ThemePreference @default(DARK) @map("theme_preference")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            UserTenant[]       @relation("MembershipUser")
  invitedMemberships     UserTenant[]       @relation("MembershipInvitedBy")
  deactivatedMemberships UserTenant[]       @relation("MembershipDeactivatedBy")
  createdTenants         Tenant[]           @relation("TenantCreatedBy")
  publishedDailyMenus    DailyMenu[]        @relation("DailyMenuPublishedBy")
  createdDailyMenus      DailyMenu[]        @relation("DailyMenuCreatedBy")
  createdCustomers       Customer[]         @relation("CustomerCreatedBy")
  createdOrders          Order[]            @relation("OrderCreatedBy")
  staffCredentials       StaffCredential[]  @relation("StaffCredentialUser")
  generatedStaffCredentials StaffCredential[] @relation("StaffCredentialGeneratedBy")
  staffSessions          StaffSession[]     @relation("StaffSessionUser")
  endedStaffSessions     StaffSession[]     @relation("StaffSessionEndedBy")
  cancelledOrders        Order[]            @relation("OrderCancelledBy")
  recordedTransactions   Transaction[]      @relation("TransactionRecordedBy")
  voidedTransactions     Transaction[]      @relation("TransactionVoidedBy")
  businessDayCloses      BusinessDayClose[] @relation("DayCloseClosedBy")
  createdPrintAgents     PrintAgent[]       @relation("PrintAgentCreatedBy")
  revokedPrintAgents     PrintAgent[]       @relation("PrintAgentRevokedBy")
  requestedPrintJobs     PrintJob[]         @relation("PrintJobRequestedBy")
  archivedPrintJobs      PrintJob[]         @relation("PrintJobArchivedBy")
  printerDiscoveries     PrinterDiscovery[] @relation("PrinterDiscoveryRequestedBy")
  auditLogs              AuditLog[]         @relation("AuditActor")
  uploadedMediaAssets    MediaAsset[]       @relation("MediaAssetUploadedBy")
  markedSocialPosts      SocialPost[]       @relation("SocialPostMarkedBy")
  createdSocialPosts     SocialPost[]       @relation("SocialPostCreatedBy")

  @@index([platformRole])
  @@map("users")
}

// ───────────────────────── E06 USER_TENANT (authorization membership, not a subscription) ─────────────────────────

model UserTenant {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  role                TenantRole
  status              MembershipStatus @default(INVITED)
  invitedByUserId     String?          @map("invited_by_user_id") @db.Uuid
  invitedAt           DateTime?        @map("invited_at") @db.Timestamptz(6)
  acceptedAt          DateTime?        @map("accepted_at") @db.Timestamptz(6)
  clerkInvitationId   String?          @unique @map("clerk_invitation_id") @db.VarChar(64)
  deactivatedAt       DateTime?        @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId String?          @map("deactivated_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy     User?  @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  deactivatedBy User?  @relation("MembershipDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)
  staffCredentials StaffCredential[] @relation("StaffCredentialMembership")
  staffSessions    StaffSession[]    @relation("StaffSessionMembership")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@index([tenantId, role, status])
  @@map("user_tenants")
}

// ───────────────────────── E07 MENU_CATEGORY ─────────────────────────

model MenuCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(80)
  description String?   @db.VarChar(500)
  iconKey     String?   @map("icon_key") @db.VarChar(40)
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  MenuItem[]

  @@unique([tenantId, id])
  @@index([tenantId, archivedAt, sortOrder])
  @@index([tenantId, isPublished])
  @@map("menu_categories")
}

// ───────────────────────── E08 MENU_ITEM ─────────────────────────

model MenuItem {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  categoryId       String       @map("category_id") @db.Uuid
  kitchenSectionId String?      @map("kitchen_section_id") @db.Uuid
  name             String       @db.VarChar(120)
  description      String?      @db.VarChar(1000)
  imageUrl         String?      @map("image_url") @db.VarChar(2048)
  iconKey          String?      @map("icon_key") @db.VarChar(40)
  basePrice        Decimal      @map("base_price") @db.Decimal(12, 2)
  taxRate          Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  dietaryType      DietaryType? @map("dietary_type")
  prepTimeMinutes  Int?         @map("prep_time_minutes") @db.SmallInt
  isAvailable      Boolean      @default(true) @map("is_available")
  isPublished      Boolean      @default(false) @map("is_published")
  displayOrder     Int          @default(0) @map("display_order")
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       MenuCategory    @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  kitchenSection KitchenSection? @relation(fields: [tenantId, kitchenSectionId], references: [tenantId, id], onDelete: Restrict)
  variants       MenuItemVariant[]
  addons         MenuItemAddon[]
  dailyMenuItems DailyMenuItem[]
  orderItems     OrderItem[]
  socialPosts    SocialPost[]

  @@unique([tenantId, id])
  @@index([tenantId, categoryId, displayOrder])
  @@index([tenantId, isPublished, isAvailable])
  @@map("menu_items")
}

// ───────────────────────── E09 MENU_ITEM_VARIANT ─────────────────────────

model MenuItemVariant {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  menuItemId   String    @map("menu_item_id") @db.Uuid
  name         String    @db.VarChar(60)
  price        Decimal   @db.Decimal(12, 2)
  isDefault    Boolean   @default(false) @map("is_default")
  isAvailable  Boolean   @default(true) @map("is_available")
  displayOrder Int       @default(0) @map("display_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
